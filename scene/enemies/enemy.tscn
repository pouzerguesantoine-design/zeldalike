[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/enemies/enemy.gd" id="1_enemy"]
[ext_resource type="Script" path="res://scripts/components/health_component.gd" id="2_health"]
[ext_resource type="Script" path="res://scripts/components/hurtbox.gd" id="3_hurtbox"]
[ext_resource type="Script" path="res://scripts/components/hitbox.gd" id="4_hitbox"]
[ext_resource type="Script" path="res://scripts/components/hit_flash.gd" id="5_flash"]
[ext_resource type="Script" path="res://scripts/components/state_machine.gd" id="6_sm"]
[ext_resource type="PackedScene" path="res://scene/ui/enemy_health_bar.tscn" id="7_bar"]
[ext_resource type="Script" path="res://scripts/enemies/states/patrol.gd" id="10_patrol"]
[ext_resource type="Script" path="res://scripts/enemies/states/chase.gd" id="11_chase"]
[ext_resource type="Script" path="res://scripts/enemies/states/attack.gd" id="12_attack"]
[ext_resource type="Script" path="res://scripts/enemies/states/return_home.gd" id="13_return_home"]
[ext_resource type="Script" path="res://scripts/enemies/states/hurt.gd" id="14_hurt"]
[ext_resource type="Script" path="res://scripts/enemies/states/dead.gd" id="15_dead"]

[sub_resource type="SphereShape3D" id="Shape_detection"]
resource_local_to_scene = true
radius = 9.0

[node name="Enemy" type="CharacterBody3D" groups=["enemies", "lockable"]]
collision_layer = 4
collision_mask = 3
script = ExtResource("1_enemy")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]

[node name="Model" type="Node3D" parent="."]

[node name="Visual" type="Node3D" parent="Model"]

[node name="Telegraph" type="Label3D" parent="Model/Visual"]
visible = false
pixel_size = 0.005
billboard = 1
no_depth_test = true
render_priority = 12
outline_render_priority = 11
modulate = Color(1, 0.2, 0.12, 1)
outline_modulate = Color(0.25, 0, 0, 1)
text = "!"
font_size = 140
outline_size = 28

[node name="AttackHitbox" type="Area3D" parent="Model"]
collision_layer = 16
collision_mask = 2
script = ExtResource("4_hitbox")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Model/AttackHitbox"]

[node name="Hurtbox" type="Area3D" parent="." node_paths=PackedStringArray("health")]
collision_layer = 4
collision_mask = 0
script = ExtResource("3_hurtbox")
health = NodePath("../HealthComponent")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Hurtbox"]

[node name="LockOnPoint" type="Marker3D" parent="."]

[node name="HealthBar" parent="." instance=ExtResource("7_bar")]

[node name="HealthComponent" type="Node" parent="."]
script = ExtResource("2_health")
invincibility_after_hit = 0.0

[node name="HitFlash" type="Node" parent="." node_paths=PackedStringArray("hurtbox", "visual_root")]
script = ExtResource("5_flash")
hurtbox = NodePath("../Hurtbox")
visual_root = NodePath("../Model/Visual")

[node name="NavigationAgent3D" type="NavigationAgent3D" parent="."]
path_desired_distance = 1.0
target_desired_distance = 1.0

[node name="DetectionArea" type="Area3D" parent="."]
collision_layer = 0
collision_mask = 2
monitorable = false

[node name="CollisionShape3D" type="CollisionShape3D" parent="DetectionArea"]
shape = SubResource("Shape_detection")

[node name="SightRay" type="RayCast3D" parent="."]
enabled = false
collision_mask = 1

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
callback_mode_process = 0

[node name="StateMachine" type="Node" parent="." node_paths=PackedStringArray("initial_state")]
script = ExtResource("6_sm")
initial_state = NodePath("Patrol")
auto_process_physics = false

[node name="Patrol" type="Node" parent="StateMachine"]
script = ExtResource("10_patrol")

[node name="Chase" type="Node" parent="StateMachine"]
script = ExtResource("11_chase")

[node name="Attack" type="Node" parent="StateMachine"]
script = ExtResource("12_attack")

[node name="Return" type="Node" parent="StateMachine"]
script = ExtResource("13_return_home")

[node name="Hurt" type="Node" parent="StateMachine"]
script = ExtResource("14_hurt")

[node name="Dead" type="Node" parent="StateMachine"]
script = ExtResource("15_dead")

